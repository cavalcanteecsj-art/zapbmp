// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mention {
  id             String   @id @default(cuid())
  mentionId      String   @unique
  groupId        String
  groupName      String
  requesterName  String
  requesterPhone String?
  messagePreview String
  createdAt      DateTime @default(now())
  firstReplyAt   DateTime?
  assignee       String?
  status         Status   @default(OPEN)
  targetSeconds  Int      @default(300)
  tags           Json?
  instanceId     String?
  instance       Instance? @relation(fields: [instanceId], references: [id])

  @@index([createdAt, status])
  @@index([groupId])
}

enum Status {
  OPEN
  OK
  LATE
  BREACHED
}

model Instance {
  id        String   @id @default(cuid())
  name      String
  status    InstanceStatus @default(PAUSED)
  lastSeen  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions  Mention[]
  auth      WhatsAuth?
}

model WhatsAuth {
  instanceId String  @id
  creds      Json
  keys       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

enum InstanceStatus {
  ACTIVE
  PAUSED
  ERROR
}

// Global catalog of reusable tags
model Tag {
  name      String     @id
  groupTags GroupTag[]
}

// Mapping of default tags per WhatsApp group
model GroupTag {
  id      String @id @default(cuid())
  groupId String
  tagName String
  tag     Tag    @relation(fields: [tagName], references: [name], onDelete: Cascade)

  @@unique([groupId, tagName])
  @@index([groupId])
}
