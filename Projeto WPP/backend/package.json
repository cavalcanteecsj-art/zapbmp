{
  "name": "whatsapp-sla-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API for WhatsApp SLA Dashboard (Node + Express + Prisma)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "debug": "^4.3.7",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^20.11.30",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10"
  }
}
